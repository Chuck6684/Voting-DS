async function castVote() {
    const voterIdInput = document.getElementById('voter_id');
    const candidateSelect = document.getElementById('candidate');
    const submitBtn = document.getElementById('submit-btn');
    const receiptDiv = document.getElementById('receipt');
    
    // NEW: Grab the token input box from the HTML
    const authTokenInput = document.getElementById('auth_token'); 

    const voter_id = voterIdInput.value.trim();
    const candidate = candidateSelect.value;
    
    // NEW: Get the actual text the user typed for the token
    const token = authTokenInput.value.trim(); 

    // Basic validation
    if (!voter_id) {
        receiptDiv.innerHTML = '⚠️ Please enter a Voter ID.';
        receiptDiv.style.color = 'orange';
        return;
    }

    // NEW: Token validation
    if (!token) {
        receiptDiv.innerHTML = '⚠️ Please enter your Secret Authorization Token.';
        receiptDiv.style.color = 'orange';
        return;
    }

    // 1. Set Loading State
    submitBtn.disabled = true;
    submitBtn.innerText = '⚙️ Running PBFT Consensus...';
    receiptDiv.innerHTML = '';

    try {
        // 2. Send the Request
        const res = await fetch('/api/vote', {
            method: 'POST',
            headers: { 
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${token}` // NEW: Attach the secret token to the request!
            },
            body: JSON.stringify({ voter_id, candidate })
        });
        const data = await res.json();
        
        // 3. Handle the Response
        // 3. Handle the Response
        if(data.status === 'success') {
            receiptDiv.innerHTML = 
                `✅ <strong>Vote Committed!</strong><br>
                <span style="color: #555; font-size: 0.9em;">PBFT Approvals: ${data.approvals}/${data.total_nodes} nodes</span><br>
                <span style="font-family: monospace; background: #e9ecef; padding: 2px 4px; border-radius: 3px;">Hash: ${data.receipt}</span>`;
            receiptDiv.style.color = 'green';
            voterIdInput.value = '';
            authTokenInput.value = ''; 

        } else {
            // NEW: Check if the backend sent a specific security message!
            if (data.message) {
                receiptDiv.innerHTML = `❌ <strong>Security Alert:</strong><br>${data.message}`;
            } else {
                // Otherwise, it was a PBFT hack failure
                receiptDiv.innerHTML = `❌ <strong>Consensus Failed!</strong><br>Approvals: ${data.approvals} / ${data.total_nodes} (Required: ${data.required})<br>Network is compromised. Vote discarded.`;
            }
            receiptDiv.style.color = 'red';
        }
    } catch (error) {
        receiptDiv.innerHTML = `❌ Network Error. Could not reach the API.`;
        receiptDiv.style.color = 'red';
    } finally {
        // 4. Reset the Button
        submitBtn.disabled = false;
        submitBtn.innerText = 'Submit Secure Vote';
        // Force an immediate dashboard update
        fetchStatus(); 
    }
}